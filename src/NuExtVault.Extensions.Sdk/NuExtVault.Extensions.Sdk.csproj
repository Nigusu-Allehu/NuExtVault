<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>NuExtVault.Extensions.Sdk</PackageId>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Description>The supported NuExtVault extension contracts.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CompatibilityStatus" Value="PublicSdkV1" />
    <InternalsVisibleTo Include="NuExtVault" />
    <InternalsVisibleTo Include="NuExtVault.Cli" />
    <InternalsVisibleTo Include="NuExtVault.Extensions.Official" />
    <InternalsVisibleTo Include="NuExtVault.Kernel" />
    <InternalsVisibleTo Include="NuExtVault.FunctionalTests" />
    <InternalsVisibleTo Include="NuExtVault.RouteFixture" />
    <InternalsVisibleTo Include="NuExtVault.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Schema\extension-manifest-v1.schema.json"
          Pack="true"
          PackagePath="contentFiles/any/any/nuextvault" />
    <None Include="Schema\extension-manifest-v2.schema.json"
          Pack="true"
          PackagePath="contentFiles/any/any/nuextvault" />
  </ItemGroup>

</Project>
