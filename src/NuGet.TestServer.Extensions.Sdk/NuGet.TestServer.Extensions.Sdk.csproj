<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>NuGet.TestServer.Extensions.Sdk</PackageId>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Description>The supported NuGet.TestServer extension contracts.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CompatibilityStatus" Value="PublicSdkV1" />
    <InternalsVisibleTo Include="NuGet.TestServer" />
    <InternalsVisibleTo Include="NuGet.TestServer.Cli" />
    <InternalsVisibleTo Include="NuGet.TestServer.Extensions.Official" />
    <InternalsVisibleTo Include="NuGet.TestServer.Kernel" />
    <InternalsVisibleTo Include="NuGet.TestServer.FunctionalTests" />
    <InternalsVisibleTo Include="NuGet.TestServer.RouteFixture" />
    <InternalsVisibleTo Include="NuGet.TestServer.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Schema\extension-manifest-v1.schema.json"
          Pack="true"
          PackagePath="contentFiles/any/any/nutestserver" />
  </ItemGroup>

</Project>
