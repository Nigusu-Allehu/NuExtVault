<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>NuExtVault.Extensions.TestKit</PackageId>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Description>Builders, fakes, and conformance helpers for NuExtVault extensions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NuExtVault.Extensions.Sdk\NuExtVault.Extensions.Sdk.csproj" />
  </ItemGroup>

</Project>
