<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>
      The composition root. It is the only assembly allowed to reference both the kernel
      and the official extension assembly: it selects the official bundle, resolves the
      profile, and hands the kernel a validated host composition.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NuGet.TestServer.Kernel\NuGet.TestServer.Kernel.csproj" />
    <ProjectReference Include="..\NuGet.TestServer.Extensions.Official\NuGet.TestServer.Extensions.Official.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NuGet.TestServer.Cli" />
    <InternalsVisibleTo Include="NuGet.TestServer.FunctionalTests" />
    <InternalsVisibleTo Include="NuGet.TestServer.RouteFixture" />
    <InternalsVisibleTo Include="NuGet.TestServer.UnitTests" />
  </ItemGroup>

</Project>
