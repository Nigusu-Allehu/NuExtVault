<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Description>
      Test-only, separately compiled conformance module. It contributes the
      /flavors/index.json endpoint, its operation, its service-index resource, and its
      requested capability through the extension abstractions only. It must never
      reference NuGet.TestServer or an official extension implementation.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NuGet.TestServer.FunctionalTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NuGet.TestServer.Extensions.Abstractions\NuGet.TestServer.Extensions.Abstractions.csproj" />
  </ItemGroup>

</Project>
